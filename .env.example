# ============================================================================
# TRADESCOUT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to .env before starting the development servers:
# Copy-Item .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=DEBUG
APP_NAME=TRADESCOUT
APP_VERSION=1.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ----------------------------------------------------------------------------
# 2. FASTAPI BACKEND CONFIGURATION
# ----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# ----------------------------------------------------------------------------
# 3. SUPABASE (DATABASE & AUTHENTICATION)
# ----------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-string

# Direct PostgreSQL Connection (Optional for local migrations / fallback)
DATABASE_URL=postgresql://tradescout:tradescout_dev@localhost:5432/tradescout

# ----------------------------------------------------------------------------
# 4. REDIS IN-MEMORY CACHE
# ----------------------------------------------------------------------------
# Local Docker Redis instance
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_HOURS=24

# ----------------------------------------------------------------------------
# 5. ZERO-SCRAPER HUGGING FACE DATASETS
# ----------------------------------------------------------------------------
HF_TEJHQ_DATASET=tejhq/indian-markets
HF_VISHNU_DATASET=vishnun0027/indian-market-historical-ohlcv
LOCAL_PARQUET_CACHE_DIR=.cache/parquet

# ----------------------------------------------------------------------------
# 6. SENTRY ERROR TRACKING & OBSERVABILITY (OPTIONAL FOR DEV)
# ----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ----------------------------------------------------------------------------
# 7. PAYMENT GATEWAY (PRO SUBSCRIPTIONS)
# ----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
